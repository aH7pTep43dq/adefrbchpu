local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local lplayer = Players.LocalPlayer

----------------------------------------------------------------
-- CONFIG (same contract as before: _G.ScoutCheat.Config.Aimbot)
-- Missing keys are filled with defaults, so the script also runs standalone.
----------------------------------------------------------------
local DEFAULTS = {
    Enabled = true,
    AimKey = Enum.UserInputType.MouseButton2, -- UserInputType or KeyCode
    AimPart = "Head",
    ClosestBone = false,
    TeamCheck = true,
    VisibleCheck = true,

    FOV_Enabled = true,
    FOV_Radius = 150,
    FOV_Color = Color3.fromRGB(255, 255, 255),
    FOV_Thickness = 1,
    FOV_Transparency = 1,

    Deadzone = 2,
    Smoothness = 0.2,
    SmoothnessVariance = false,
    CurveSmoothing = false,

    Randomization = false,
    RandomIntensity = 0.5,

    CurveAiming = false,
    CurveStrength = 1,

    Acceleration = 0,
    Braking = 0,

    MicroTremor = false,
    TremorIntensity = 1,
}

local Aim = ((_G.ScoutCheat or {}).Config or {}).Aimbot
if type(Aim) ~= "table" then Aim = {} end
for key, default in pairs(DEFAULTS) do
    if Aim[key] == nil then Aim[key] = default end
end

-- registry of connections / drawings so the main framework can clean up
local genv = (getgenv and getgenv()) or _G
genv.ScoutCheat = genv.ScoutCheat or {}
local registry = genv.ScoutCheat
registry._connections = registry._connections or {}
registry._drawings = registry._drawings or {}

local myConnections = {}

local function reg(c)
    table.insert(registry._connections, c)
    table.insert(myConnections, c)
    return c
end

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local aiming = false
local randomOffset = Vector3.zero
local lastOffsetChange = 0
local currentTarget = nil
local curveSign = 1

local function randomVector(intensity)
    return Vector3.new(
        (math.random() - 0.5) * intensity,
        (math.random() - 0.5) * intensity,
        (math.random() - 0.5) * intensity
    )
end

----------------------------------------------------------------
-- FOV CIRCLE
----------------------------------------------------------------
local FOVCircle = Drawing.new("Circle")
FOVCircle.Filled = false
table.insert(registry._drawings, FOVCircle)

----------------------------------------------------------------
-- VISIBILITY
-- One shared RaycastParams (created once, filter refreshed once per frame).
-- RespectCanCollide ignores non-collidable parts (invisible triggers etc.).
----------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
rayParams.RespectCanCollide = true

local function isVisible(cam, character, part)
    local origin = cam.CFrame.Position
    local result = Workspace:Raycast(origin, part.Position - origin, rayParams)
    -- nothing hit, or the first thing hit already belongs to the target
    return result == nil or result.Instance:IsDescendantOf(character)
end

----------------------------------------------------------------
-- TARGET SELECTION
----------------------------------------------------------------
-- R15 first, R6 names as fallback (missing parts are simply skipped)
local BONES = {
    "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso",
    "RightUpperArm", "LeftUpperArm", "RightUpperLeg", "LeftUpperLeg",
    "Torso", "Right Arm", "Left Arm", "Right Leg", "Left Leg",
}

local bestPlayer, bestPart, bestDist

-- cheap screen-distance test first; the (expensive) raycast only runs
-- when the part would actually beat the current best candidate
local function consider(cam, mouse, plr, character, part)
    if not part then return end
    local pos, onScreen = cam:WorldToViewportPoint(part.Position)
    if not onScreen then return end

    local d = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
    if d >= bestDist then return end
    if Aim.VisibleCheck and not isVisible(cam, character, part) then return end

    bestPlayer, bestPart, bestDist = plr, part, d
end

local function getTarget(cam, mouse)
    bestPlayer, bestPart, bestDist = nil, nil, Aim.FOV_Radius
    local myTeam = lplayer.Team

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == lplayer then continue end

        local character = plr.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        -- only skip teammates when teams actually exist (fixes FFA games where
        -- both teams are nil and every player used to count as a teammate)
        if Aim.TeamCheck and myTeam ~= nil and plr.Team == myTeam then continue end

        if Aim.ClosestBone then
            for _, boneName in ipairs(BONES) do
                consider(cam, mouse, plr, character, character:FindFirstChild(boneName))
            end
        else
            consider(cam, mouse, plr, character, character:FindFirstChild(Aim.AimPart))
        end
    end

    return bestPlayer, bestDist, bestPart
end

----------------------------------------------------------------
-- INPUT
----------------------------------------------------------------
local function isAimKey(input)
    return input.UserInputType == Aim.AimKey or input.KeyCode == Aim.AimKey
end

reg(UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not isAimKey(input) then return end
    aiming = true
    if Aim.Randomization then
        randomOffset = randomVector(Aim.RandomIntensity)
    end
end))

reg(UserInputService.InputEnded:Connect(function(input)
    if isAimKey(input) then
        aiming = false
        currentTarget = nil
    end
end))

----------------------------------------------------------------
-- MAIN LOOP
----------------------------------------------------------------
reg(RunService.RenderStepped:Connect(function(dt)
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local mouse = UserInputService:GetMouseLocation()

    -- FOV circle (all properties live, so GUI changes apply immediately)
    FOVCircle.Position = mouse
    FOVCircle.Radius = Aim.FOV_Radius
    FOVCircle.Color = Aim.FOV_Color
    FOVCircle.Thickness = Aim.FOV_Thickness
    FOVCircle.Transparency = Aim.FOV_Transparency
    FOVCircle.Visible = Aim.FOV_Enabled

    if not (Aim.Enabled and aiming) then
        currentTarget = nil
        return
    end

    -- refresh the raycast filter once per frame
    local filter = { cam }
    if lplayer.Character then filter[2] = lplayer.Character end
    rayParams.FilterDescendantsInstances = filter

    local target, distToMouse, part = getTarget(cam, mouse)
    if not (target and part) then
        currentTarget = nil
        return
    end

    if target ~= currentTarget then
        currentTarget = target
        curveSign = math.random() > 0.5 and 1 or -1
    end

    if distToMouse <= Aim.Deadzone then return end

    local camPos = cam.CFrame.Position
    local tPos = part.Position

    if Aim.Randomization then
        local now = tick()
        if now - lastOffsetChange > 0.2 then
            randomOffset = randomOffset:Lerp(randomVector(Aim.RandomIntensity), 0.1)
            lastOffsetChange = now
        end
        tPos += randomOffset
    end

    if Aim.CurveAiming then
        local toTarget = tPos - camPos
        local rightVec = toTarget:Cross(Vector3.yAxis)
        rightVec = rightVec.Magnitude > 0 and rightVec.Unit or cam.CFrame.RightVector
        local scale = (distToMouse / Aim.FOV_Radius) * (toTarget.Magnitude * 0.1 * Aim.CurveStrength)
        tPos += rightVec * curveSign * scale
    end

    local smoothness = Aim.Smoothness

    -- braking: slow down as the crosshair gets close to the target
    if Aim.Acceleration > 0 or Aim.Braking > 0 then
        local toTarget = tPos - camPos
        if toTarget.Magnitude > 0 then
            local angle = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)))
            smoothness *= math.clamp(angle / (Aim.FOV_Radius * 0.5), Aim.Braking * 0.1, 1)
        end
    end

    if Aim.CurveSmoothing then
        smoothness *= math.clamp(distToMouse / Aim.FOV_Radius, 0.15, 1)
    end

    if Aim.SmoothnessVariance then
        smoothness += (math.random() - 0.5) * (smoothness * 0.2)
    end

    if Aim.MicroTremor then
        tPos += randomVector(0.05 * Aim.TremorIntensity)
    end

    -- frame-rate independent smoothing: the same speed at 30, 60 or 240 FPS
    -- (identical to the old fixed alpha at 60 FPS)
    local base = math.clamp(smoothness, 0.005, 1)
    local alpha = 1 - (1 - base) ^ (math.min(dt, 0.1) * 60)

    cam.CFrame = cam.CFrame:Lerp(CFrame.new(camPos, tPos), alpha)
end))

----------------------------------------------------------------
-- UNLOAD (callable from the framework: getgenv().ScoutCheat.UnloadAimbot())
----------------------------------------------------------------
registry.UnloadAimbot = function()
    aiming = false
    currentTarget = nil
    for _, c in ipairs(myConnections) do pcall(function() c:Disconnect() end) end
    table.clear(myConnections)
    pcall(function() FOVCircle:Remove() end)
end
